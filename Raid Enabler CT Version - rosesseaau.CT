]]

local selectionIndexList = [[
0:First
1:Second
2:Third
]]


local function processRecord(rec, list, listName, DropDownReadOnly, DropDownDescriptionOnly, DisplayAsDropDownListItem)
  if rec.DropDownList and rec.DropDownList.Text and rec.DropDownList.Text:match(listName) then
     rec.DropDownList.Text = list
     rec.DropDownReadOnly = DropDownReadOnly
     rec.DropDownDescriptionOnly = DropDownDescriptionOnly
     rec.DisplayAsDropDownListItem = DisplayAsDropDownListItem
  end
  for j = 0, rec.Count - 1 do
     processRecord(rec.Child[j], list, listName, DropDownReadOnly, DropDownDescriptionOnly, DisplayAsDropDownListItem)
  end
end

local function addDropDownList(list, listName, ...)
  local DropDownReadOnly, DropDownDescriptionOnly, DisplayAsDropDownListItem = ...
  local al = getAddressList()
  for i = 0, al.Count - 1 do
     processRecord(al[i], list, listName, DropDownReadOnly, DropDownDescriptionOnly, DisplayAsDropDownListItem)
  end
end

addDropDownList(missionIDList, "0:MissionID", false, false, true)
addDropDownList(aircraftIDList, "0:AircraftID", false, false, true)
addDropDownList(SPWIDList, "0:SPWID", false, false, true)
addDropDownList(emblemIDList, "0:EmblemID", false, false, true)
addDropDownList(partIDList, "0:PartID", false, false, true)
addDropDownList(selectionIndexList, "0:SelectionIndex", false, false, true)

-- 2 Byte Big Endian

function BE2BytesToValue(b1, b2)

    return
        (b1 &lt;&lt; 8) |
        b2
end

function BE2ValueToBytes(val)

    val = val &amp; 0xFFFF

    local b1 = (val &gt;&gt; 8) &amp; 0xFF
    local b2 = val &amp; 0xFF

    return b1, b2
end

local BE2Type = registerCustomTypeLua(
    "2 Byte Big Endian",
    2,
    BE2BytesToValue,
    BE2ValueToBytes
)

-- 3 Byte Big Endian

function BE3BytesToValue(b1, b2, b3)

    return
        (b1 &lt;&lt; 16) |
        (b2 &lt;&lt; 8 ) |
        b3
end

function BE3ValueToBytes(val)

    val = val &amp; 0xFFFFFF

    local b1 = (val &gt;&gt; 16) &amp; 0xFF
    local b2 = (val &gt;&gt; 8 ) &amp; 0xFF
    local b3 = val &amp; 0xFF

    return b1, b2, b3
end

local BE3Type = registerCustomTypeLua(
    "3 Byte Big Endian",
    3,
    BE3BytesToValue,
    BE3ValueToBytes
)

-- 4 Byte Big Endian

function BE4BytesToValue(b1, b2, b3, b4)

    return
        (b1 &lt;&lt; 24) |
        (b2 &lt;&lt; 16) |
        (b3 &lt;&lt; 8 ) |
        b4
end

function BE4ValueToBytes(val)

    val = val &amp; 0xFFFFFFFF

    local b1 = (val &gt;&gt; 24) &amp; 0xFF
    local b2 = (val &gt;&gt; 16) &amp; 0xFF
    local b3 = (val &gt;&gt; 8 ) &amp; 0xFF
    local b4 = val &amp; 0xFF

    return b1, b2, b3, b4
end

local BE4Type = registerCustomTypeLua(
    "4 Byte Big Endian",
    4,
    BE4BytesToValue,
    BE4ValueToBytes
)


-- Float Big Endian
function BEFloatBytesToValue(b1, b2, b3, b4)
    if not b1 or not b2 or not b3 or not b4 then return 0.0 end
    local str = string.char(b1, b2, b3, b4)
    local status, val = pcall(function() return string.unpack("&gt;f", str) end)
    if status then return val else return 0.0 end
end

function BEFloatValueToBytes(val)
    val = tonumber(val) or 0.0
    local status, str = pcall(function() return string.pack("&gt;f", val) end)
    if status and str and #str == 4 then
        return str:byte(1), str:byte(2), str:byte(3), str:byte(4)
    else
        return 0, 0, 0, 0
    end
end

registerCustomTypeLua(
    "Float Big Endian",
    4,
    BEFloatBytesToValue,
    BEFloatValueToBytes,
    true
)
</LuaScript>
</CheatTable>
