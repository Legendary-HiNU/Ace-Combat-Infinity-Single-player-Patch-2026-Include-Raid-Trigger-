    <CheatEntry>
      <ID>51400</ID>
      <Description>"[EMERGENCY SORTIE] Aktifkan Raid Setelah Misi Selesai (Auto-Trigger Red Alert)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local pages = {
    0x301300000,
    0x300115000,
    0x3000B2000,
    0x300127000,
    0x3000A5000,
    0x30011F000,
    0x300043000,
    0x300022000,
    0x3002EC000
}

for _, addr in ipairs(pages) do
    fullAccess(addr, 0x1000)
end

-- 0. Neutralize Master Anti-Cheat, ev_cheat sender, and NextStageID
writeBytes(0x3000435DC, 0x38, 0x60, 0x00, 0x00, 0x4E, 0x80, 0x00, 0x20)
writeBytes(0x3000221FC, 0x38, 0x60, 0x00, 0x00, 0x4E, 0x80, 0x00, 0x20)
writeBytes(0x3002EC830, 0x38, 0x60, 0x00, 0x00, 0x4E, 0x80, 0x00, 0x20)

-- 1. Baca 4 byte big-endian dari 0x301300000
local b = readBytes(0x301300000, 4, true)
local current_val = 0
if b and #b == 4 then
    current_val = b[1] * 0x1000000 + b[2] * 0x10000 + b[3] * 0x100 + b[4]
end

-- Jika belum valid (antara 500 dan 519), default ke 514 (SOLG IV Black: 0x00000202)
if current_val &lt; 500 or current_val &gt; 519 then
    writeBytes(0x301300000, 0x00, 0x00, 0x02, 0x02)
end

-- 2. Force REAL IsResulNextRaidMission engine function (0x3000AB820) -&gt; return 1 (true)
fullAccess(0x3000AB000, 0x1000)
writeBytes(0x3000AB820, 0x38, 0x60, 0x00, 0x01, 0x4E, 0x80, 0x00, 0x20)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

fullAccess(0x3000AB000, 0x1000)
writeBytes(0x3000AB820, 0x80, 0x62, 0xB7, 0x70, 0x38, 0x80, 0x00, 0x00)
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>51411</ID>
          <Description>"[UNIVERSAL RAID] Set Semua Map Jadi Raid (_stageIsRaid=1 untuk Apapun Mapnya)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local tbl_base = 0x312880000
for i = 0, 213 do
    writeBytes(tbl_base + i * 0x1C4 + 0xA4, 0x00, 0x00, 0x4E, 0x00)
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
local tbl_base = 0x312880000
for i = 0, 213 do
    writeBytes(tbl_base + i * 0x1C4 + 0xA4, 0x00, 0x00, 0x06, 0x00)
end
{$asm}
</AssemblerScript>
